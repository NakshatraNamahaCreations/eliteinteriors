# ------------------------------------------------------------
# Enquiry mail. Every form on the site posts to /api/contact.
#
# Primary: Gmail SMTP. SMTP_PASS must be a 16-character Google
# App Password (Google Account -> Security -> 2-Step Verification
# -> App passwords), NOT the normal account password.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
CONTACT_TO=where-enquiries-should-land@example.com

# ------------------------------------------------------------
# Fallback: formsubmit.co. Used only when SMTP credentials are
# missing or the SMTP server rejects them. Needs no password;
# the destination inbox activates it once by clicking the link
# in the first mail it receives.
# ------------------------------------------------------------
FORMSUBMIT_TO=where-enquiries-should-land@example.com
